<Window x:Class="CapCut2.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CapCut 2 • Studio" Width="1280" Height="820" MinWidth="900" MinHeight="670"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <SolidColorBrush x:Key="Surface" Color="#1C2028"/>
    <SolidColorBrush x:Key="Soft" Color="#252B35"/>
    <SolidColorBrush x:Key="Dim" Color="#95A1B1"/>
  </Window.Resources>
  <Grid Background="#101218">
    <Grid.RowDefinitions>
      <RowDefinition Height="54"/>
      <RowDefinition Height="*" MinHeight="290"/>
      <RowDefinition Height="7"/>
      <RowDefinition Height="245" MinHeight="170"/>
      <RowDefinition Height="25"/>
    </Grid.RowDefinitions>
    <!-- Top toolbar -->
    <Border Grid.Row="0" Background="#1B1E26" BorderBrush="#30343E" BorderThickness="0,0,0,1">
      <DockPanel Margin="14,0">
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
          <TextBlock Text="CapCut 2" FontSize="19" FontWeight="Bold" Margin="0,0,16,0"/>
          <TextBlock Text="STUDIO / LIGHT" Foreground="#69CCBC" FontSize="10" VerticalAlignment="Center"/>
          <Border Background="#343B47" Padding="9,5" Margin="16,0,0,0" CornerRadius="5">
            <TextBlock x:Name="MediaName" Text="Projeto sem mídia" Foreground="#C0CAD7" TextTrimming="CharacterEllipsis" MaxWidth="230"/>
          </Border>
        </StackPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button x:Name="UpdateButton" Content="↻ Atualizações" Click="CheckUpdates_Click"/>
          <Button Content="＋ Importar mídia" Click="Open_Click"/>
          <Button Content="↗ Exportar MP4" Background="#147D76" Click="Export_Click" FontWeight="SemiBold"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="230" MinWidth="175"/>
        <ColumnDefinition Width="5"/>
        <ColumnDefinition Width="*" MinWidth="350"/>
        <ColumnDefinition Width="5"/>
        <ColumnDefinition Width="250" MinWidth="200"/>
      </Grid.ColumnDefinitions>
      <!-- Library -->
      <Border Grid.Column="0" Background="#1B1E26" Padding="11">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="MÍDIA" FontSize="12" FontWeight="Bold" Foreground="#E4E9EF" Margin="5,6,0,10"/>
            <Button Content="＋ Importar vídeo ou áudio" Click="Open_Click"/>
            <TextBlock Text="Arquivos do projeto" Foreground="#8995A5" FontSize="11" Margin="5,13,0,8"/>
          </StackPanel>
          <ListBox x:Name="MediaList" Background="#1B1E26" Foreground="White" BorderThickness="0"
                   SelectionChanged="MediaList_SelectionChanged" Margin="0,85,0,0"/>
        </DockPanel>
      </Border>
      <GridSplitter Grid.Column="1" Width="5" Background="#12151B" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext"/>

      <!-- Preview and transport -->
      <Grid Grid.Column="2" Background="#151820">
        <Grid.RowDefinitions><RowDefinition Height="31"/><RowDefinition Height="*"/><RowDefinition Height="90"/></Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="12,7">
          <TextBlock Text="PRÉ-VISUALIZAÇÃO" Foreground="#B5C0CD" FontSize="11"/>
          <TextBlock x:Name="PreviewInfo" Text="1920 × 1080 • Ajustar" FontSize="11" Foreground="#7D8998" HorizontalAlignment="Right"/>
        </DockPanel>
        <Border Grid.Row="1" Background="#090B0F" Margin="12,0" CornerRadius="5" ClipToBounds="True">
          <Grid>
            <MediaElement x:Name="Player" Stretch="Uniform" LoadedBehavior="Manual" UnloadedBehavior="Close"
                          MediaOpened="Player_MediaOpened" MediaEnded="Player_MediaEnded"
                          MediaFailed="Player_MediaFailed"/>
            <TextBlock x:Name="EmptyHint" Text="Importe um vídeo para começar" FontSize="16"
                       Foreground="#8795A7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Grid>
        </Border>
        <StackPanel Grid.Row="2" VerticalAlignment="Center">
          <TextBlock x:Name="ClockText" HorizontalAlignment="Center" Text="00:00.000 / 00:00.000"
                     Foreground="#D5DDE6" FontSize="12" Margin="0,0,0,5"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="−1s" Click="Back_Click"/>
            <Button x:Name="PlayButton" Content="▶ Reproduzir" Click="Play_Click" MinWidth="110"/>
            <Button Content="+1s" Click="Forward_Click"/>
            <Button Content="◆ Batida" Click="Beat_Click"/>
          </StackPanel>
        </StackPanel>
      </Grid>
      <GridSplitter Grid.Column="3" Width="5" Background="#12151B" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext"/>

      <!-- Inspector -->
      <ScrollViewer Grid.Column="4" Background="#1B1E26" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">
          <TextBlock Text="PROPRIEDADES" Foreground="#E2E7EE" FontWeight="Bold" FontSize="12" Margin="4,8,0,18"/>
          <TextBlock Text="Vídeo" FontSize="15" FontWeight="SemiBold" Margin="4,0,0,9"/>
          <TextBlock Text="Enquadramento" Foreground="#99A7B8" FontSize="12" Margin="4,0,0,5"/>
          <ComboBox x:Name="FitChoice" SelectionChanged="FitChoice_Changed" SelectedIndex="0">
            <ComboBoxItem Content="Ajustar"/>
            <ComboBoxItem Content="Preencher"/>
            <ComboBoxItem Content="Esticar"/>
          </ComboBox>
          <TextBlock Text="Corte (segundos)" Foreground="#99A7B8" Margin="4,18,0,6"/>
          <TextBlock Text="Início" Foreground="#8C99A9" Margin="4,3,0,2"/>
          <TextBox x:Name="StartBox" Text="0.000"/>
          <Button Content="Marcar início no cursor" Click="Start_Click"/>
          <TextBlock Text="Fim" Foreground="#8C99A9" Margin="4,10,0,2"/>
          <TextBox x:Name="EndBox" Text="0.000"/>
          <Button Content="Marcar fim no cursor" Click="End_Click"/>
          <Separator Margin="0,16"/>
          <CheckBox x:Name="KeepAudio" IsChecked="True" Content="Manter áudio original" Foreground="#D6DFE8" Margin="4"/>
          <TextBlock Text="O corte MP4 preserva os codecs originais. Transformações visuais alteram só a prévia."
                     Foreground="#8291A1" FontSize="11" TextWrapping="Wrap" Margin="5,12,0,0"/>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <GridSplitter Grid.Row="2" Height="7" HorizontalAlignment="Stretch" Background="#0D1016"
                  ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"/>

    <!-- Timeline -->
    <Border Grid.Row="3" Background="#1C2028" Padding="11">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="30"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel Grid.Row="0">
          <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
            <TextBlock Text="TIMELINE" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Margin="4,0,18,0"/>
            <Button Content="◆ Marcar batida" Click="Beat_Click"/>
            <Button Content="Limpar batidas" Click="ClearBeats_Click"/>
          </StackPanel>
          <TextBlock x:Name="BeatsText" Text="Nenhuma batida marcada" Foreground="#9BAABA" FontSize="11"
                     HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </DockPanel>
        <Slider Grid.Row="1" x:Name="Timeline" Minimum="0" Maximum="1" Margin="127,0,2,0"
                ValueChanged="Timeline_ValueChanged"
                PreviewMouseLeftButtonDown="Timeline_MouseDown"
                PreviewMouseLeftButtonUp="Timeline_MouseUp"/>
        <Grid Grid.Row="2" Margin="0,5,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="126"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <Border Background="#262C35" Padding="8" Margin="0,0,4,5" CornerRadius="4">
              <TextBlock Text="V1   Vídeo" Foreground="#D5E0EA" FontSize="12"/>
            </Border>
            <Border Background="#262C35" Padding="8" Margin="0,0,4,0" CornerRadius="4">
              <TextBlock Text="A1   Áudio" Foreground="#D5E0EA" FontSize="12"/>
            </Border>
          </StackPanel>
          <Grid Grid.Column="1" ClipToBounds="True">
            <Grid.RowDefinitions><RowDefinition Height="37"/><RowDefinition Height="37"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#141820" CornerRadius="4" Margin="0,0,0,4"/>
            <Border Grid.Row="1" Background="#141820" CornerRadius="4"/>
            <Border x:Name="VideoTrackClip" Grid.Row="0" Width="0" HorizontalAlignment="Left" Background="#4778C5"
                    CornerRadius="4" Margin="0,2,0,5" Visibility="Collapsed" MaxWidth="1400">
              <TextBlock x:Name="ClipText" Margin="9,6" Foreground="White" FontSize="12" TextTrimming="CharacterEllipsis"/>
            </Border>
            <Border x:Name="AudioTrackClip" Grid.Row="1" Width="0" HorizontalAlignment="Left" Background="#257C6D"
                    CornerRadius="4" Margin="0,2,0,1" Visibility="Collapsed" MaxWidth="1400">
              <TextBlock Text="Áudio original" Margin="9,6" Foreground="#D5FFED" FontSize="12"/>
            </Border>
          </Grid>
        </Grid>
      </Grid>
    </Border>
    <DockPanel Grid.Row="4" Background="#11141B" LastChildFill="False">
      <TextBlock x:Name="StatusText" Text="Pronto para importar um vídeo." Foreground="#8ACCB5"
                 Margin="14,4" FontSize="11" DockPanel.Dock="Left" TextTrimming="CharacterEllipsis"/>
      <TextBlock Text="CAPCUT 2 • 1.1.0" Foreground="#6E7D8C" DockPanel.Dock="Right" Margin="14,4" FontSize="10"/>
    </DockPanel>
  </Grid>
</Window>